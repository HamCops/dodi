# Numeric league id from the ESPN URL:
# https://fantasy.espn.com/football/league?leagueId=123456789
ESPN_LEAGUE_ID=

# Season year of the draft.
ESPN_SEASON=2026

# Your team id within the league (integer). Find it in the URL when you open
# your own roster: .../team?leagueId=...&teamId=3
# Optional: if unset, roster tools require an explicit team_id argument.
ESPN_TEAM_ID=

# --- Private league auth ---
# Only needed if the league is private (most are). Get these from a browser
# that is logged in to ESPN:
#   DevTools -> Application -> Cookies -> https://fantasy.espn.com
# Copy the FULL values. SWID includes the surrounding braces.
# These are session credentials: treat them like a password, never commit .env.
# Only this file, in the project root, is read; a .env in the working directory
# the server happens to be launched from is ignored.
ESPN_S2=
SWID={00000000-0000-0000-0000-000000000000}

# Seconds to cache the player pool. The draft-state endpoint is never cached.
ESPN_POOL_TTL=900

# --- Approval queue (optional) ---
# With this on, add_player, drop_player, propose_trade and respond_to_trade
# refuse apply=true. The agent queues them with request_approval instead, and
# they are sent to ESPN only once approved. set_lineup and move_player stay direct.
ESPN_REQUIRE_APPROVAL=0

# Where proposals are pushed. The push carries the approve/reject tokens, so
# protect the topic: set ntfy's auth-default-access to deny-all and give this a
# write-only token. NTFY_TOKEN wins; otherwise the token is read from
# NTFY_TOKEN_FILE (default ~/.config/ntfy/publish-token, keep it mode 600).
# Leave both unset only for a topic nobody else can reach.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# NTFY_TOKEN_FILE=~/.config/ntfy/publish-token

# Public base URL of the approval service (espn-mcp-approve), as the phone
# reaches it. The service itself listens on 127.0.0.1:APPROVE_PORT; put it
# behind something private (a tailnet, a VPN), never the open internet.
APPROVE_BASE_URL=
APPROVE_PORT=6075

# --- Outside data (optional) ---
# Adds trade-market values (FantasyCalc), pickup trends and a second weekly
# projection (Sleeper) to every player. Public APIs, no keys; nothing about
# your league is sent beyond its size and scoring. Cached under state/cache.
ESPN_EXTERNAL_SOURCES=0

# --- Game-time scheduling (optional) ---
# Run espn-mcp-tick every five minutes (a systemd timer or cron). It sets the
# lineup and sends approval requests counted back from each kickoff on your
# roster, so decisions are made late but reach you with time to answer.
# Minutes you want to decide in:
APPROVAL_LEAD_MINUTES=30
# Your time zone, for the deadlines shown in notifications:
ESPN_TIMEZONE=America/New_York
# Executable run when the agent should look for moves, as:
#   <hook> agent <weekday> <kickoff ISO 8601 UTC>
GAMETIME_HOOK=
