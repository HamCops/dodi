# Numeric league id from the ESPN URL:
# https://fantasy.espn.com/football/league?leagueId=123456789
ESPN_LEAGUE_ID=

# Season year of the draft.
ESPN_SEASON=2026

# Your team id within the league (integer). Find it in the URL when you open
# your own roster: .../team?leagueId=...&teamId=3
# Optional: if unset, roster tools require an explicit team_id argument.
ESPN_TEAM_ID=

# --- Private league auth ---
# Only needed if the league is private (most are). Get these from a browser
# that is logged in to ESPN:
#   DevTools -> Application -> Cookies -> https://fantasy.espn.com
# Copy the FULL values. SWID includes the surrounding braces.
# These are session credentials: treat them like a password, never commit .env.
# Only this file, in the project root, is read; a .env in the working directory
# the server happens to be launched from is ignored.
ESPN_S2=
SWID={00000000-0000-0000-0000-000000000000}

# Seconds to cache the player pool. The draft-state endpoint is never cached.
ESPN_POOL_TTL=900
